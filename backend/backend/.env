   # Application
APP_NAME=Resume Coach
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# SageMaker
SAGEMAKER_ENDPOINT_NAME=llama2-13b-chat-endpoint

# S3 Buckets
S3_BUCKET_RESUMES=resume-coach-resumes
S3_BUCKET_JOBS=resume-coach-jobs

# DynamoDB Tables
DYNAMODB_TABLE_USERS=resume-coach-users
DYNAMODB_TABLE_ANALYSES=resume-coach-analyses
DYNAMODB_TABLE_SESSIONS=resume-coach-sessions

# LLM Settings
DEFAULT_TEMPERATURE=0.5
DEFAULT_MAX_TOKENS=800
CONTEXT_WINDOW_SIZE=4096

# OpenAI (for development/fallback)
OPENAI_API_KEY=your_openai_key_here
USE_OPENAI_FALLBACK=True

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,docx,txt
